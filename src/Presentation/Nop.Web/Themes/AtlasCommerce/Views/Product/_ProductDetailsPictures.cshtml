@model ProductDetailsModel

@{
    Layout = "";
    var hasMultiplePictures = Model.PictureModels.Count > 1;
    var pictures = Model.PictureModels.Count > 0
        ? Model.PictureModels
        : new List<PictureModel> {
              new PictureModel {
                  ImageUrl = Model.DefaultPictureModel.ImageUrl,
                  FullSizeImageUrl = Model.DefaultPictureModel.FullSizeImageUrl,
                  ThumbImageUrl = Model.DefaultPictureModel.ImageUrl,
                  AlternateText = Model.DefaultPictureModel.AlternateText,
                  Title = Model.DefaultPictureModel.Title
              }
          };
}

<div class="atlas-gallery" data-productid="@Model.Id">
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsBeforePictures, additionalData = Model })

    <div class="atlas-gallery-main-wrapper">
        <div class="atlas-gallery-main" id="atlas-gallery-@Model.Id">
            <div class="atlas-gallery-track" data-index="0">
                @foreach (var picture in pictures)
                {
                    <div class="atlas-gallery-slide">
                        <img src="@picture.ImageUrl"
                             data-full="@picture.FullSizeImageUrl"
                             alt="@picture.AlternateText"
                             title="@picture.Title"
                             loading="lazy"
                             class="atlas-gallery-img" />
                    </div>
                }
            </div>

            <button type="button" class="atlas-gallery-zoom-hint" aria-label="Zoom">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M11 4a7 7 0 1 1-4.9 11.9l-3.4 3.4a1 1 0 0 1-1.4-1.4l3.4-3.4A7 7 0 0 1 11 4zm0 2a5 5 0 1 0 0 10 5 5 0 0 0 0-10z" fill="currentColor"/>
                    <path d="M11 8a1 1 0 0 1 1 1v1h1a1 1 0 0 1 0 2h-1v1a1 1 0 0 1-2 0v-1H9a1 1 0 0 1 0-2h1V9a1 1 0 0 1 1-1z" fill="currentColor"/>
                </svg>
            </button>

            @if (hasMultiplePictures)
            {
                <button type="button" class="atlas-gallery-arrow atlas-gallery-prev" aria-label="Previous image">
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                        <path d="M15.5 5.5L9 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <button type="button" class="atlas-gallery-arrow atlas-gallery-next" aria-label="Next image">
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                        <path d="M8.5 5.5L15 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            }
            <div class="atlas-gallery-counter">
                <span class="atlas-gallery-counter-current">1</span>
                <span class="atlas-gallery-counter-sep">/</span>
                <span class="atlas-gallery-counter-total">@pictures.Count</span>
            </div>
        </div>
    </div>

    @if (hasMultiplePictures)
    {
        <div class="atlas-gallery-thumbs" aria-label="Product image thumbnails">
            <button type="button" class="atlas-gallery-thumbs-arrow atlas-gallery-thumbs-up" aria-label="Scroll up">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                    <path d="M6 14l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="atlas-gallery-thumbs-track" data-thumbs>
                @foreach (var picture in pictures)
                {
                    <button type="button" class="atlas-gallery-thumb" data-index="@pictures.IndexOf(picture)" aria-label="Show image @(pictures.IndexOf(picture) + 1)">
                        <img src="@picture.ThumbImageUrl" alt="@picture.AlternateText" loading="lazy" />
                    </button>
                }
            </div>
            <button type="button" class="atlas-gallery-thumbs-arrow atlas-gallery-thumbs-down" aria-label="Scroll down">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                    <path d="M6 10l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>
    }

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsAfterPictures, additionalData = Model })

    <script asp-exclude-from-bundle="true" src="~/Themes/AtlasCommerce/Content/js/atlas.gallery.js" asp-location="Footer"></script>
</div>

@* Lightbox overlay — rendered once, dismissed by AtlasGallery.close() *@
<div class="atlas-lightbox" data-atlas-lightbox hidden aria-hidden="true">
    <button type="button" class="atlas-lightbox-close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
    </button>
    <button type="button" class="atlas-lightbox-nav atlas-lightbox-prev" aria-label="Previous">
        <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
            <path d="M15.5 5.5L9 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
    <div class="atlas-lightbox-stage">
        <img class="atlas-lightbox-img" alt="" />
    </div>
    <button type="button" class="atlas-lightbox-nav atlas-lightbox-next" aria-label="Next">
        <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
            <path d="M8.5 5.5L15 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
    <div class="atlas-lightbox-counter">1 / @pictures.Count</div>
</div>
