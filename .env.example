# nopCommerce Production Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   chmod 600 .env
#
# Generate a strong password with:
#   openssl rand -base64 32

# SQL Server SA password (REQUIRED)
# Must meet SQL Server complexity requirements:
#   - At least 8 characters
#   - Mix of uppercase, lowercase, digits, and symbols
DB_PASSWORD=NopCommerce_Db#2026

# Optional: S3 bucket for remote backups
# S3_BUCKET=my-nopcommerce-backups
