# nopCommerce Production Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   chmod 600 .env
#
# Generate a strong password with:
#   openssl rand -base64 32

# SQL Server SA password (REQUIRED)
# PostgreSQL database credentials for the container
POSTGRES_USER=nopcommerce
POSTGRES_PASSWORD=ChangeThisToAStrongPassword!

# Optional: S3 bucket for remote backups
# S3_BUCKET=my-nopcommerce-backups
